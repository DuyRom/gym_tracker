datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String?
  avatarUrl     String?
  role          String    @default("MEMBER")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      WorkoutSession[]
  accounts      Account[]
  workoutDays   WorkoutDay[]
  scheduleLogs  ScheduleActivityLog[]
  aiCoachSessions AiCoachSession[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String  @default("credentials")
  provider          String  @default("credentials")
  providerAccountId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model WorkoutDay {
  id          String   @id @default(cuid())
  userId      String?  // null = template mặc định hệ thống; có userId = lịch tùy biến của user
  dayOfWeek   Int      // 1=T2, 2=T3, 3=T4, 4=T5, 5=T6, 6=T7, 7=CN
  name        String   // "Thân Trên A (Upper A)"
  focus       String   // "Ngực Ngang, Lưng Xô, Lưng Dày & Tay Sau"
  dayType     String   @default("TRAINING") // TRAINING | RECOVERY
  durationMin Int      @default(45)

  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises   Exercise[]
  sessions    WorkoutSession[]

  @@index([userId, dayOfWeek])
  @@map("workout_days")
}

model Exercise {
  id            String   @id @default(cuid())
  workoutDayId  String
  orderIndex    Int
  nameVi        String
  nameEn        String
  equipment     String
  sets          Int
  repsMin       Int
  repsMax       Int
  rir           String
  techniqueNote String   @db.Text
  videoUrl      String?
  isArchived    Boolean  @default(false)

  workoutDay    WorkoutDay @relation(fields: [workoutDayId], references: [id], onDelete: Cascade)
  sessionExercises SessionExercise[]

  @@map("exercises")
}

model WorkoutSession {
  id            String    @id @default(cuid())
  userId        String
  workoutDayId  String
  date          DateTime  @default(now())
  startedAt     DateTime?
  endedAt       DateTime?
  durationMin   Int?
  status        String    @default("PLANNED") // PLANNED, IN_PROGRESS, COMPLETED, MISSED
  notes         String?   @db.Text

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutDay    WorkoutDay     @relation(fields: [workoutDayId], references: [id], onDelete: Cascade)
  exercises     SessionExercise[]

  @@index([userId, status])
  @@index([userId, date])
  @@map("workout_sessions")
}

model SessionExercise {
  id              String   @id @default(cuid())
  sessionId       String
  exerciseId      String
  completed       Boolean  @default(false)
  actualSets      Int?
  actualReps      String?
  actualWeightKg  Float?
  notes           String?

  session         WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise        Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  aiCoachSessions AiCoachSession[]

  @@unique([sessionId, exerciseId])
  @@map("session_exercises")
}

model ScheduleActivityLog {
  id        String   @id @default(cuid())
  userId    String
  action    String   // MOVE, ADD, DELETE, EDIT, REORDER, RESET
  details   String   @db.Text
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("schedule_activity_logs")
}

model AiCoachSession {
  id                String   @id @default(cuid())
  userId            String
  sessionExerciseId String?
  exerciseType      String   // 'squat', 'bicep_curl', 'shoulder_press', 'pushup', 'lat_pulldown', 'cable_row', 'lateral_raise'
  exerciseName      String
  totalReps         Int
  goodReps          Int
  avgFormScore      Float
  durationSec       Int
  feedbackSummary   String?  @db.Text
  createdAt         DateTime @default(now())

  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionExercise   SessionExercise? @relation(fields: [sessionExerciseId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([sessionExerciseId])
  @@map("ai_coach_sessions")
}

