# ========================================================
# GYM TRACKER ENVIRONMENT CONFIGURATION (DOCKER / LOCAL)
# ========================================================

# MariaDB / MySQL Configuration for Docker Compose
DB_NAME=gym_tracker
DB_USER=gym_user
DB_PASSWORD=your_strong_password_here
DB_ROOT_PASSWORD=your_strong_root_password_here

# Next.js Application Environment
NODE_ENV=production
NEXT_PUBLIC_BASE_URL=https://fit.odinbi.app

# Database URL used by Prisma:
# Inside Docker container, host is "db":
DATABASE_URL=mysql://${DB_USER}:${DB_PASSWORD}@db:3306/${DB_NAME}?charset=utf8mb4

# For local development outside docker (e.g. against localhost MariaDB):
# DATABASE_URL=mysql://root:password@localhost:3306/gym_tracker?charset=utf8mb4

# Authentication Secrets (minimum 32 random characters)
JWT_SECRET=replace_with_secure_random_string_min_32_chars
